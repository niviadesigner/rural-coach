# ============================================================
# RURAL COACH — Variables de entorno
# Copia este archivo a .env.local y pega tus llaves reales.
# NADA de esto se sube a git (.env.local está en .gitignore).
# ============================================================

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# En producción: https://app.ruralcycle.cc

# ---------- Supabase ----------
# Créalo en https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role: SOLO backend (edge functions / route handlers). Nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---------- Strava ----------
# https://www.strava.com/settings/api
# Ya tienes el Client ID — pégalo aquí:
NEXT_PUBLIC_STRAVA_CLIENT_ID=TU_CLIENT_ID
STRAVA_CLIENT_SECRET=TU_CLIENT_SECRET
# Token de verificación que tú inventas para dar de alta el webhook de Strava:
STRAVA_WEBHOOK_VERIFY_TOKEN=rural-coach-verify-2026
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback

# ---------- Wompi (pagos COP) ----------
# https://comercios.wompi.co → Desarrolladores. Empieza en modo sandbox.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_...
WOMPI_PRIVATE_KEY=prv_test_...
WOMPI_EVENTS_SECRET=stagtest_events_...
WOMPI_INTEGRITY_SECRET=stagtest_integrity_...

# ---------- Modo de desarrollo ----------
# true = usa datos mock y no exige integraciones reales (Strava/Wompi/Supabase).
# Permite correr la app end-to-end sin credenciales todavía.
NEXT_PUBLIC_MOCK_MODE=true
